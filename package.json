{
  "name": "forma-ai-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "COACH_MODE=mock next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:build": "tsx scripts/build-mannequin.ts",
