# Copy to .env.local (never commit .env.local). Server-only: never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6.1-sol
# low | medium | high — low keeps the coach snappy on a phone
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=20000

# "openai" (default) or "mock" (deterministic keyword coach for offline dev / e2e tests)
COACH_MODE=openai
COACH_RATE_LIMIT_PER_MIN=12

# Avatar service (services/avatar on Modal; see services/avatar/README.md). Leave empty to hide
# the "Create my avatar" button. AVATAR_TOKEN is server-only and must match the Modal secret.
AVATAR_SERVICE_URL=
NEXT_PUBLIC_AVATAR_SERVICE_URL=
AVATAR_TOKEN=
# Optional: people must type this code before uploading photos (protects your Modal credit)
AVATAR_ACCESS_CODE=
AVATAR_RATE_LIMIT_PER_HOUR=6
